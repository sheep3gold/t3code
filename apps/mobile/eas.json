{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "T3CODE_MOBILE_VERSION": "3.0.0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "SOURCEMAP_FILE": "/tmp/t3code-ios-main.jsbundle.map",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleRelease -x lintVitalAnalyzeRelease -x lintVitalRelease"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "fork-testflight": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "store",
      "channel": "fork-testflight",
      "env": {
        "T3CODE_IOS_PERSONAL_TEAM": "0",
        "T3CODE_IOS_BUNDLE_ID": "com.yangxin.t3code.fork",
        "T3CODE_APPLE_TEAM_ID": "Q6768H569J",
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubGlzdG15YmxvZy5jbiQ",
        "EXPO_PUBLIC_CLERK_JWT_TEMPLATE": "t3-relay",
        "T3CODE_RELAY_URL": "https://relay.listmyblog.cn"
      }
    }
  },
  "submit": {
    "testflight": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    },
    "fork-testflight": {
      "ios": {
        "ascAppId": "6831013532",
        "appleTeamId": "Q6768H569J",
        "bundleIdentifier": "com.yangxin.t3code.fork"
      }
    }
  }
}
